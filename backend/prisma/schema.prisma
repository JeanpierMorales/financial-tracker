generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MovementType {
  INCOME
  EXPENSE
  TRANSFER
}

enum PaymentMethod {
  CASH
  YAPE
  BANK_TRANSFER
}

enum AccountType {
  CASH
  BANK
  WALLET
  SAVINGS
  INVESTMENT
  OTHER
}

enum CurrencyCode {
  PEN
  USD
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model User {
  id         String   @id @default(uuid())
  authUserId String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  movements    Movement[]
  budgets      Budget[]
  accounts     Account[]
  savingsGoals SavingsGoal[]
  categories   Category[]
}

model Category {
  id        String   @id @default(uuid())
  userId    String?
  name      String   @db.VarChar(80)
  icon      String?  @db.VarChar(40)
  color     String?  @db.VarChar(7)
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements Movement[]
  budgets   Budget[]
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, isActive])
}

model Movement {
  id                       String         @id @default(uuid())
  userId                   String
  categoryId               String?
  sourceAccountId          String?
  destinationAccountId     String?
  type                     MovementType
  amount                   Decimal        @db.Decimal(14, 2)
  description              String?
  date                     DateTime
  paymentMethod            PaymentMethod
  destinationPaymentMethod PaymentMethod?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category           Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sourceAccount      Account?  @relation("MovementSourceAccount", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  destinationAccount Account?  @relation("MovementDestinationAccount", fields: [destinationAccountId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([date])
  @@index([categoryId])
  @@index([userId, date])
  @@index([userId, type, date])
  @@index([sourceAccountId, date])
  @@index([destinationAccountId, date])
}

model Account {
  id             String       @id @default(uuid())
  userId         String
  name           String       @db.VarChar(80)
  type           AccountType
  currency       CurrencyCode @default(PEN)
  initialBalance Decimal      @default(0) @db.Decimal(14, 2)
  institution    String?      @db.VarChar(80)
  lastFour       String?      @db.VarChar(4)
  color          String?      @db.VarChar(7)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  outgoingMovements Movement[]    @relation("MovementSourceAccount")
  incomingMovements Movement[]    @relation("MovementDestinationAccount")
  savingsGoals      SavingsGoal[]

  @@unique([userId, name])
  @@index([userId, isActive])
  @@index([userId, type])
}

model Budget {
  id         String   @id @default(uuid())
  userId     String
  categoryId String
  amount     Decimal  @db.Decimal(14, 2)
  startDate  DateTime
  endDate    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@index([userId])
  @@index([categoryId])
  @@index([startDate, endDate])
  @@index([userId, categoryId, startDate, endDate])
}

model SavingsGoal {
  id            String     @id @default(uuid())
  userId        String
  accountId     String?
  name          String     @db.VarChar(100)
  targetAmount  Decimal    @db.Decimal(14, 2)
  currentAmount Decimal    @default(0) @db.Decimal(14, 2)
  deadline      DateTime?
  status        GoalStatus @default(ACTIVE)
  color         String?    @db.VarChar(7)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([accountId])
}
